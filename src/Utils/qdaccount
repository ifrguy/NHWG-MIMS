# Quick & Dirty build a Google Workspace wing account
# Outputs an appropriate gam command to create an account

# History:
# 29Oct26 MEG Added option -D to specify fqdn.
# 09May25 MEG Added OU 004 for AEM's.
# 06Apr25 MEG Member Type can now be a quoted string, e.g. "CADET SPONSOR"
# 15Mar23 MEG Add new unit 023
# 25Jul22 MEG Checks for duplicate account name.
# 10Mar21 MEG Fixed gam create syntax error.
# 05Sep20 MEG Removed Google schema, replaced with custom schema values
# 17Aug19 MEG Included custom schema att's.
# 15Mar19 MEG Rationalized arg handling, added help message.
# 01Mar19 MEG Created.
# INPUT:
# $1 - base account name
# $2 - CAPID
# $3 - first name
# $4 - last name
# $5 - Unit number 
# $6 - Member Type: CADET|SENIOR|"<string>"
# $7 - Password
# $8 - Notification email address
# OUTPUT: appropriate gam command to create an account

# Path to email message template
EMAIL_TEMPLATE=$HOME/work/NHWG/Templates/new-user-email-template.html

# Domain in which to create account
# YOUR DOMAIN HERE, MAY BE OVERRIDDEN BY -D <domain>
DOMAIN=""

# Command options
OPTS=D:h?

# Help message
USAGE="Usage: $(basename $0) [$OPTS] args\n
Build a gam command to create a Google account\n
---You must have GAM7 installed and have a Google application key---\n
Options:\n
\tD - domain ($DOMAIN)\n
\th|? - Print usage and exit\n
ARGS:\n
\t\$1 - new account base name\n
\t\$2 - CAPID\n
\t\$3 - First name\n
\t\$4 - Last name \"last name\"\n
\t\$5 - Unit number: 000-999\n
\t\$6 - Member Type: CADET|SENIOR|\"<string>\"\n
\t\$7 - Password\n
\t\$8 - Notification email address\n"


# Map unit charter number to a Google Workspace org unit path
# Example mapping:
#         ORGUNIT[000]="/000 - Wing Reserve Unit"
# One entry per unit
declare -A ORGUNIT
# mappings here

while getopts $OPTS o; do
    case $o in
	D) DOMAIN=$OPTARG;;
	h|?) echo -e $USAGE;exit 1;;
    esac
done
shift $(( $OPTIND - 1 ))


if (( $# < 8 )); then
    echo -e $USAGE
    echo "Organization Units: " ${ORGUNIT[@]}
    exit 1
fi

# check for duplicate account
gam info user $1@$DOMAIN >/dev/null &>/dev/null
if [[ $? = 0 ]]; then
    echo "ERROR:Duplicate account: $1"
    exit 1
fi    

echo "/usr/local/bin/gam create user $1@$DOMAIN givenname "$3" familyname "$4" orgunitpath "${ORGUNIT[$5]}" Member.CAPID $2 Member.Type "$6" Member.Unit $5 password $7 changepassword true notify "$8" subject "Welcome to your NH Wing account" file $EMAIL_TEMPLATE html true"
